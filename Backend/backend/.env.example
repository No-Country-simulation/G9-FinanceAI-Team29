# ==========================================================
#  Variables de entorno del Backend  (las lee spring-dotenv)
#  Copiá este archivo a ".env" en esta misma carpeta y completá los valores.
#  El .env está gitignored: los secretos NUNCA van al repositorio.
#  Versión OCI (auto-hospedado): ya NO se usa Supabase.
# ==========================================================

# --- Base de datos (Postgres propio del stack) ---
# En docker-compose, DB_URL/DB_USER/DB_PASS los inyecta el compose apuntando
# al servicio "postgres" (DB_PASS lo pisa POSTGRES_PASSWORD del .env raíz).
# Para correr el backend SUELTO (sin compose) sí completá estos:
DB_URL=jdbc:postgresql://localhost:5432/finsight
DB_USER=finsight
DB_PASS=

# --- Auth service-to-service (AI-Service -> backend) ---
# Secreto compartido con el AI-Service. Debe tener EXACTAMENTE el mismo valor allá.
SERVICE_TOKEN=

# --- Email (Resend): reset de contraseña y recordatorios ---
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend.
EMAIL_FROM=FinSightAI <noreply@tu-dominio.com>
# Logo opcional para los emails (URL pública). Default: vacío.
EMAIL_LOGO_URL=

# --- Web Push (VAPID): recordatorios push en el navegador ---
# Sin estas claves, los recordatorios van solo por email.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@dominio.com

# --- Job diario de recordatorios (metas/eventos que vencen en 3 días) ---
RECORDATORIOS_CRON=0 0 9 * * *
RECORDATORIOS_ZONE=America/Argentina/Buenos_Aires

# --- URL pública del sitio (para los links de los emails) ---
SITE_URL=http://localhost

# --- CORS (opcional) ---
# Orígenes del frontend permitidos, separados por coma.
# Default: http://localhost:5173,http://localhost:3000
# Detrás de Caddy (same-origin) no hace falta. En el VM agregá tu dominio si aplica.
ALLOWED_ORIGINS=

# --- Admins (opcional) ---
# Emails con acceso total (ver perfiles de otros). Default: demo.admin@finsight.com
ADMIN_EMAILS=

# Nota: JAVA_HOME NO va acá (lo necesita Maven antes de arrancar Spring).
