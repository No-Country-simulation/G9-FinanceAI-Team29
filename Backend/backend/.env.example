# ==========================================================
#  Variables de entorno del Backend  (las lee spring-dotenv)
#  Copiá este archivo a ".env" en esta misma carpeta y completá los valores.
#  El .env está gitignored: los secretos NUNCA van al repositorio.
# ==========================================================

# --- Base de datos (Supabase · pooler transaction, puerto 6543) ---
# DB_URL y DB_USER ya tienen default en application.yml; podés omitirlos.
DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USER=postgres.wfypvyfhpworindwllsz
DB_PASS=

# --- Supabase Auth (Admin API) ---
SUPABASE_URL=https://wfypvyfhpworindwllsz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth service-to-service (AI-Service → backend) ---
# Secreto compartido con el AI-Service. Debe tener EXACTAMENTE el mismo valor allá.
SERVICE_TOKEN=

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma. Default (si se omite):
# http://localhost:5173,http://localhost:3000. En prod agregá la URL de Vercel.
ALLOWED_ORIGINS=

# --- Admins (opcional) ---
# Emails con acceso total (ver perfiles de otros). Default: demo.admin@finsight.com
ADMIN_EMAILS=

# Nota: JAVA_HOME NO va acá (lo necesita Maven antes de arrancar Spring).
# Se setea como variable del sistema o con el script levantar-back.ps1.
