# Variante de Caddyfile para desarrollo (docker-compose.dev.yml).
# Igual que Caddyfile, pero el catch-all apunta al vite dev server (HMR)
# en vez de al nginx con el build estático.

{$SITE_ADDRESS:http://localhost} {
	# /api/* → backend Spring (mantiene el prefijo /api, que el backend espera).
	handle /api/* {
		reverse_proxy backend:8081
	}

	# /ai/* → AI-Service FastAPI (le saca el /ai; el servicio sirve /agent/chat, etc.).
	handle /ai/* {
		uri strip_prefix /ai
		reverse_proxy ai-service:8000
	}

	# Todo lo demás → vite dev server (HMR vía websocket, mismo origen).
	handle {
		reverse_proxy frontend:5173
	}

	encode gzip zstd
}
