# ─────────────────────────────────────────────────────────────
#  .env RAÍZ — solo se usa en el VM (producción / OCI).
#  Copiar a ".env" en la raíz del repo EN EL VM y completar valores.
#  Compose lo lee para interpolar el docker-compose.yml.
#  En local NO hace falta: sin este archivo, todo resuelve a MinIO.
# ─────────────────────────────────────────────────────────────

# Postgres (la BD propia del stack). Elegí una contraseña fuerte en el VM.
POSTGRES_PASSWORD=cambia_esto_en_el_vm

# ── Object Storage OCI: avatares (backend) ──
STORAGE_S3_ENDPOINT=https://axbfxlbxcrrn.compat.objectstorage.sa-valparaiso-1.oraclecloud.com
STORAGE_S3_REGION=sa-valparaiso-1
STORAGE_S3_ACCESS_KEY=<access key de tenancy.md>
STORAGE_S3_SECRET_KEY=<secret key de tenancy.md>
STORAGE_AVATARS_BUCKET=finsight-avatars
STORAGE_AVATARS_PUBLIC_URL=https://objectstorage.sa-valparaiso-1.oraclecloud.com/n/axbfxlbxcrrn/b/finsight-avatars/o

# ── Object Storage OCI: modelos ML (ai-service) ──
MODELS_S3_ENDPOINT=https://axbfxlbxcrrn.compat.objectstorage.sa-valparaiso-1.oraclecloud.com
MODELS_S3_REGION=sa-valparaiso-1
MODELS_S3_ACCESS_KEY=<access key de tenancy.md>
MODELS_S3_SECRET_KEY=<secret key de tenancy.md>
MODELS_S3_BUCKET=finsight-models
