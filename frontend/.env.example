VITE_API_URL=http://localhost:8080/api
VITE_AI_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para las funciones serverless en /api (Vercel). NO llevan prefijo VITE_
# a propósito: si lo tuvieran, Vite las metería en el bundle del navegador.
# Se configuran como variables de entorno del proyecto en Vercel, no se exponen al cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Opcional: si no se define, se usa el origin de la propia request.
SITE_URL=
# Opcional: si no se define, usa el logo blanco alojado en postimg.cc.
EMAIL_LOGO_URL=
