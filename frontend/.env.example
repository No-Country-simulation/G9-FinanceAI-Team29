VITE_API_URL=http://localhost:8080/api
VITE_AI_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clave pública VAPID (no es secreta): debe ser la misma que VAPID_PUBLIC_KEY de abajo.
VITE_VAPID_PUBLIC_KEY=

# Solo para las funciones serverless en /api (Vercel). NO llevan prefijo VITE_
# a propósito: si lo tuvieran, Vite las metería en el bundle del navegador.
# Se configuran como variables de entorno del proyecto en Vercel, no se exponen al cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Opcional: si no se define, se usa el origin de la propia request.
SITE_URL=
# Opcional: si no se define, usa el logo blanco alojado en postimg.cc.
EMAIL_LOGO_URL=

# Notificaciones push del calendario financiero (Web Push / VAPID).
# Generadas una sola vez con `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contacto que ven los navegadores/push services si hay abuso.
VAPID_SUBJECT=mailto:soporte@finsightai.com

# Protege /api/enviar-recordatorios para que solo lo dispare el Cron de Vercel
# (que manda este valor como "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
